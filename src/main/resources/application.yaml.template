server:
  port: 8081
logging:
  level:
    root: DEBUG
spring:
  application:
    name:
      cubesat-service
  datasource:
    url: jdbc:postgresql://localhost:5432/database
    username: user
    password: password
  jpa:
    hibernate:
      ddl-auto: none
    properties:
      hibernate:
        format_sql: true
  liquibase:
    change-log: classpath:db/changelog/changelog.xml
    enabled: true